[
  {
    "intro": {
      "title": "Inputs and Production",
      "description": [
        "Climate change will cause a great strain on crucial inputs such as water and labor. Rainfall variability and drought affect water availability and can result in harvest losses and poor crop quality. Increased temperatures will lead to unsafe working conditions, causing workers to lose income and resulting in decreased labor productivity. More frequent extreme weather events such as flooding will also harm crop quality and quantity. All of these impacts and more will ultimately effect incomes for workers in these value chain nodes."
      ],
      "banner_image":"/images/adaptation/banner_images/cotton_input.png"
    }
  }
